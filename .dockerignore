# Docker ignore file - excludes large files from build context
# Mirrors .gitignore but focuses on reducing build context size

# CRITICAL: Large data directories (mounted as volumes instead)
weights/
videos/
dataset/
output/
outputs/
outputs_compare/
subs/
logs/
vis/
tmp/
*tmp_*/
debug*/
dump/

# Model weights (mounted at runtime)
*.pth
*.pt
*.ckpt
*.safetensors

# Video files
*.mp4
*.avi
*.mov
*.mkv

# Image files
*.jpg
*.jpeg
*.png
*.bmp
*.tiff

# Evaluation results
eval/results/
track_results.txt
*.csv

# Keep staged perception_msgs.
# The rule that kept requirements.txt is gone with the file,
# instead the dependency list is the `docker` extra in pyproject.toml.
!_msgs_build/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Jupyter notebooks
.ipynb_checkpoints/
*.ipynb

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# The created pixi environment (build context) -- ~12 GB in size.
# Dockerfile.ros2 builds its own
# from pixi.lock inside the image so no need to keep this directory
# since it would be redundant with the environment the image just created from pixi install.
.pixi/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Documentation (not needed in image)
*.md
# ...except README.md, which is not documentation as far as the build is
# concerned: pyproject.toml declares `readme = "README.md"`, and hatchling
# fails with "Readme file does not exist" if it is not in the build context.
!README.md
docs/
/site

# Configs that will be mounted
grounding/config/configs
grounding/version.py

# Test coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
